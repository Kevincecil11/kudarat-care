# Public site URL (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Supabase project "Kudarat Care" (public values, safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://hvxztbrquhebaypfibgr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Dashboard > Project Settings > API keys. Never commit or expose this.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (server secret never goes in NEXT_PUBLIC_ variables)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Consult a Doctor: clinic WhatsApp number with country code, digits only (e.g. 9198XXXXXXXX)
NEXT_PUBLIC_CLINIC_WHATSAPP=

# Business WhatsApp for bulk/consultant enquiries and contact
NEXT_PUBLIC_BUSINESS_WHATSAPP=

# Google Analytics 4 measurement ID
NEXT_PUBLIC_GA_ID=

# Set only by the private preview workflow
# NEXT_PUBLIC_PREVIEW=1
# NEXT_PUBLIC_BASE_PATH=/kudarat-care/<hidden-folder>
