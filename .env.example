# Public site URL (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Set to 1 on staging (e.g. the vercel.app address) so Google does not index it before launch
NEXT_PUBLIC_NOINDEX=1

# Supabase project "Kudarat Care" (public values, safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://hvxztbrquhebaypfibgr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Dashboard > Project Settings > API keys (service_role). Never commit or expose this.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (server secret never goes in NEXT_PUBLIC_ variables). Use test keys (rzp_test_...) until launch.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Admin "Publish changes" button. Vercel > Project > Settings > Git > Deploy Hooks (branch: fullstack)
VERCEL_DEPLOY_HOOK_URL=

# Optional fallbacks; normally set in Admin > Site settings
NEXT_PUBLIC_CLINIC_WHATSAPP=
NEXT_PUBLIC_BUSINESS_WHATSAPP=

# Google Analytics 4 measurement ID
NEXT_PUBLIC_GA_ID=

# Set only by the private preview workflow
# NEXT_PUBLIC_PREVIEW=1
# NEXT_PUBLIC_BASE_PATH=/kudarat-care/<hidden-folder>
